<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="com.github.ApkManager" path="/com/github/ApkManager/">
    <key name="decode-jobs" type="i">
      <default>4</default>
      <summary>Parallel Apktool decode jobs</summary>
      <description>Number of parallel jobs passed to Apktool during full decode.</description>
    </key>
    <key name="java-heap-mb" type="i">
      <default>1024</default>
      <summary>Java heap size in megabytes</summary>
      <description>Maximum heap size for the Apktool Java subprocess.</description>
    </key>
    <key name="window-width" type="i">
      <default>960</default>
      <summary>Main window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Main window height</summary>
    </key>
  </schema>
</schemalist>
